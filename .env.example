# -----------------------------------------------------------------------------
# Shayonam Digital - Environment Configuration Example
# Copy this file to .env for local development with wrangler.
# NEVER commit real keys or secrets to git.
# -----------------------------------------------------------------------------

# Cloudflare D1 Database (managed locally via wrangler or remote D1 binding)
# Local: wrangler d1 execute shayonam-db --local
# Remote: wrangler d1 execute shayonam-db --remote

# Resend API Key (for lead notifications to owner)
RESEND_API_KEY=re_your_api_key_here

# Notification recipient email (where leads will be sent)
OWNER_NOTIFICATION_EMAIL=shayonamdigitals@gmail.com

# Cloudflare Turnstile Bot Protection
# Generate site key & secret key in Cloudflare Dashboard -> Turnstile
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAABBBBBBBBCCCCCC
TURNSTILE_SECRET_KEY=0x4AAAAAAABBBBBBBBCCCCCCDDDDDDDDDDDD

# Optional: Port override for local development
PORT=4321
