---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { ArrowRight, CheckCircle2 } from 'lucide-react';
---

<BaseLayout
  title="Digital Services - Shayonam Digital Bhavnagar"
  description="Explore our core services: website design, custom web applications, social media handling, website redesigns, and website care plans."
>
  <!-- Page Header -->
  <section class="py-14 md:py-20 border-b border-[var(--border-light)] bg-[var(--surface)]">
    <div class="site-container max-w-3xl text-center mx-auto space-y-4">
      <div class="inline-flex items-center space-x-2 py-1 px-3 rounded-full bg-[var(--paper)] text-xs font-semibold text-[var(--amber-text)] border border-[var(--border-light)]">
        <span>Tailored Capabilities</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-[var(--ink)] tracking-tight">
        Services engineered for growth.
      </h1>
      <p class="text-base text-[var(--ink-muted)] leading-relaxed">
        Whether you are building your first digital presence or replacing a sluggish legacy site, we deliver high-performance web engineering with direct accountability.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-16 md:py-24 bg-[var(--paper)]">
    <div class="site-container space-y-16">
      {siteConfig.services.map((svc, idx) => (
        <article class="p-8 sm:p-10 rounded-2xl bg-[var(--surface)] border border-[var(--border-light)] grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-5 space-y-4">
            <span class="text-xs font-bold font-display text-[var(--amber-text)] uppercase tracking-wider">
              Service 0{idx + 1}
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold font-display text-[var(--ink)]">
              {svc.title}
            </h2>
            <p class="text-sm text-[var(--ink-muted)] leading-relaxed">
              {svc.outcome}
            </p>

            <div class="pt-2 text-xs text-[var(--ink-muted)] border-t border-[var(--border-light)]">
              <strong class="text-[var(--ink)]">Ideal for:</strong> {svc.forWhom}
            </div>

            <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center gap-3">
              <a
                href={svc.path}
                class="btn-tactile inline-flex items-center space-x-2 py-2.5 px-5 rounded-lg bg-[var(--ink)] hover:bg-[var(--espresso)] text-[var(--paper)] font-semibold text-xs transition-colors"
              >
                <span>Read Full Details</span>
                <ArrowRight className="w-3.5 h-3.5 text-[var(--amber)]" />
              </a>
              <a
                href={`/contact?service=${svc.slug}`}
                class="btn-tactile inline-flex items-center space-x-1.5 py-2.5 px-4 text-xs font-semibold text-[var(--amber-text)] hover:underline"
              >
                <span>Request a Quote &rarr;</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 bg-[var(--paper)] p-6 sm:p-8 rounded-xl border border-[var(--border-light)]">
            <h3 class="text-sm font-bold font-display uppercase tracking-wider text-[var(--ink)] mb-4">
              What's Included
            </h3>
            <ul class="space-y-3">
              {svc.deliverables.map((item) => (
                <li class="flex items-start space-x-3 text-xs sm:text-sm text-[var(--ink-muted)]">
                  <CheckCircle2 className="w-4 h-4 text-[var(--amber-text)] flex-shrink-0 mt-0.5" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
