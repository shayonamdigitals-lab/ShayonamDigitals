---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import ContactForm from '@/components/islands/ContactForm';
import { Phone, MessageSquare, Mail, MapPin, ExternalLink, Clock } from 'lucide-react';

const requestedService = Astro.url.searchParams.get('service') || undefined;
const requestedType = Astro.url.searchParams.get('type') === 'audit' ? 'audit' : 'contact';
---

<BaseLayout
  title="Contact Us - Shayonam Digital Bhavnagar"
  description="Get in touch with Shayonam Digital in Bhavnagar, Gujarat. Contact us for website design, custom web apps, or a free 2-day website audit."
>
  <section class="py-12 md:py-20 bg-[var(--paper)]">
    <div class="site-container">
      <div class="max-w-2xl mb-12">
        <div class="inline-flex items-center space-x-2 py-1 px-3 rounded-full bg-[var(--surface)] text-xs font-semibold text-[var(--amber-text)] border border-[var(--border-light)] mb-3">
          <span>Start a Project</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-[var(--ink)] tracking-tight">
          Let's talk about your business website.
        </h1>
        <p class="mt-3 text-base text-[var(--ink-muted)] leading-relaxed">
          Fill out the project form below or reach out directly on WhatsApp. We provide honest estimates, clear deliverables, and prompt responses.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left Column: Contact Cards -->
        <div class="lg:col-span-5 space-y-6">
          <!-- WhatsApp Primary Contact Card -->
          <div class="p-6 rounded-2xl bg-[#25D366]/10 border border-[#25D366]/20 space-y-3">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-full bg-[#25D366] text-white flex items-center justify-center">
                <MessageSquare className="w-5 h-5" />
              </div>
              <div>
                <h3 class="font-display font-bold text-base text-[var(--ink)]">
                  WhatsApp (Fastest Response)
                </h3>
                <p class="text-xs text-[var(--ink-muted)]">Available Mon - Sat, 9:30 AM to 7:00 PM</p>
              </div>
            </div>
            <p class="text-xs text-[var(--ink-muted)] leading-relaxed">
              Prefer messaging over filling forms? Send us a message on WhatsApp for quick inquiries or consultation.
            </p>
            <div class="pt-2">
              <a
                href={siteConfig.contact.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-tactile inline-flex items-center space-x-2 py-2.5 px-4 rounded-lg bg-[#25D366] text-white font-semibold text-xs shadow-xs"
              >
                <span>Message {siteConfig.contact.whatsappDisplay}</span>
                <ExternalLink className="w-3.5 h-3.5" />
              </a>
            </div>
          </div>

          <!-- Other Contact Channels -->
          <div class="p-6 rounded-2xl bg-[var(--surface)] border border-[var(--border-light)] space-y-5 text-sm">
            <div class="flex items-start space-x-3.5">
              <Phone className="w-5 h-5 text-[var(--amber-text)] flex-shrink-0 mt-0.5" />
              <div>
                <div class="font-semibold text-[var(--ink)]">Voice Calls</div>
                <div class="text-xs text-[var(--ink-muted)] mt-0.5">Direct line for inquiries</div>
                <a
                  href={`tel:${siteConfig.contact.phoneTel}`}
                  class="font-medium text-[var(--amber-text)] hover:underline mt-1 inline-block"
                >
                  {siteConfig.contact.phoneDisplay}
                </a>
              </div>
            </div>

            <div class="flex items-start space-x-3.5 border-t border-[var(--border-light)] pt-4">
              <Mail className="w-5 h-5 text-[var(--amber-text)] flex-shrink-0 mt-0.5" />
              <div>
                <div class="font-semibold text-[var(--ink)]">Email Inquiries</div>
                <div class="text-xs text-[var(--ink-muted)] mt-0.5">Send RFPs or formal requirements</div>
                <a
                  href={`mailto:${siteConfig.contact.email}`}
                  class="font-medium text-[var(--amber-text)] hover:underline mt-1 inline-block break-all"
                >
                  {siteConfig.contact.email}
                </a>
              </div>
            </div>

            <div class="flex items-start space-x-3.5 border-t border-[var(--border-light)] pt-4">
              <MapPin className="w-5 h-5 text-[var(--amber-text)] flex-shrink-0 mt-0.5" />
              <div>
                <div class="font-semibold text-[var(--ink)]">Office Location</div>
                <div class="text-xs text-[var(--ink-muted)] mt-0.5">
                  Bhavnagar, Gujarat 364001, India
                </div>
                <a
                  href="https://maps.google.com/?q=Bhavnagar+Gujarat+India"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-[var(--amber-text)] hover:underline mt-1.5 inline-flex items-center space-x-1"
                >
                  <span>Open in Google Maps</span>
                  <ExternalLink className="w-3 h-3" />
                </a>
              </div>
            </div>
          </div>

          <!-- Turnaround Promise -->
          <div class="p-4 rounded-xl bg-[var(--surface-alt)] border border-[var(--border-light)] flex items-center space-x-3 text-xs text-[var(--ink-muted)]">
            <Clock className="w-4 h-4 text-[var(--amber-text)] flex-shrink-0" />
            <span>We review every inquiry and reply within one working day.</span>
          </div>
        </div>

        <!-- Right Column: Interactive Form Island -->
        <div class="lg:col-span-7">
          <ContactForm
            client:load
            initialType={requestedType}
            defaultService={requestedService}
            whatsappUrl={siteConfig.contact.whatsappUrl}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
